#!/usr/bin/env node
// hash-threads — Threads 공식 API(graph.threads.net)만 부르는 작은 CLI. 의존성 없음 (Node 22+).
//
// 안전 장치
// - 토큰은 macOS 키체인(서비스 `hash-threads`)에 둔다. 출력·로그에 토큰을 찍는 명령은 없다.
// - 보내는 곳은 graph.threads.net 하나로 고정 (바꾸는 옵션·환경 변수를 두지 않는다).
// - 게시·답글은 매번 사람이 확인한다: macOS는 시스템 대화 상자, 그 밖에는 터미널 y/N.
//   에이전트가 끌 수 있는 옵션은 없다. 확인할 화면이 없으면 게시하지 않는다.
// - login·logout은 사람이 터미널에서만 (TTY가 아니면 거절).
//
// 사용: hash-threads help

import { execFileSync } from "node:child_process";
import { openSync, readSync, writeSync, closeSync } from "node:fs";

const API = "https://graph.threads.net";
const VERSION = "v1.0";
const KEYCHAIN_SERVICE = "hash-threads";
const KEYCHAIN_ACCOUNT = "access-token";
const MAX_TEXT = 500;
const isMac = process.platform === "darwin";

class CliError extends Error {}

// MARK: 토큰

function readToken() {
  if (isMac) {
    try {
      const token = execFileSync("/usr/bin/security",
        ["find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", KEYCHAIN_ACCOUNT, "-w"],
        { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
      if (token) return token;
    } catch {}
  }
  // macOS 밖에서는 환경 변수 (키체인이 없을 때만)
  const env = process.env.THREADS_ACCESS_TOKEN?.trim();
  if (env) return env;
  throw new CliError("Threads 토큰이 없습니다. 사람이 터미널에서 `hash-threads login`을 실행해야 합니다.");
}

function saveToken(token) {
  if (!isMac) throw new CliError("토큰 저장은 macOS 키체인만 지원합니다. 다른 OS에서는 THREADS_ACCESS_TOKEN 환경 변수를 쓰세요.");
  // -U: 있으면 바꾼다. 값이 argv로 잠깐 지나간다 (이 기기 안에서만).
  execFileSync("/usr/bin/security",
    ["add-generic-password", "-U", "-s", KEYCHAIN_SERVICE, "-a", KEYCHAIN_ACCOUNT, "-l", "Threads (hash-threads)", "-w", token],
    { stdio: "ignore" });
}

function deleteToken() {
  if (!isMac) return;
  try {
    execFileSync("/usr/bin/security", ["delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", KEYCHAIN_ACCOUNT], { stdio: "ignore" });
  } catch {}
}

// MARK: API

async function call(method, path, params = {}, token = readToken()) {
  const url = new URL(path.startsWith("/refresh") ? path : `/${VERSION}${path}`, API);
  const init = { method, headers: {} };
  if (method === "GET") {
    for (const [k, v] of Object.entries(params)) url.searchParams.set(k, String(v));
    url.searchParams.set("access_token", token);
  } else {
    // POST는 토큰을 주소가 아니라 본문에
    init.headers["Content-Type"] = "application/x-www-form-urlencoded";
    init.body = new URLSearchParams({ ...params, access_token: token }).toString();
  }
  let response;
  try {
    response = await fetch(url, init);
  } catch (error) {
    throw new CliError(`Threads에 연결하지 못했습니다: ${error.message}`);
  }
  const body = await response.json().catch(() => ({}));
  if (!response.ok || body.error) {
    const e = body.error ?? {};
    const hint = e.code === 190 ? " (토큰이 만료됐거나 취소됨 — 사람이 `hash-threads login`으로 다시 넣어야 합니다)"
      : e.code === 10 || e.code === 200 ? " (앱에 이 권한이 없습니다 — README의 권한 목록 확인)" : "";
    throw new CliError(`Threads API 오류 ${response.status}${e.code ? ` / ${e.code}` : ""}: ${e.message ?? "알 수 없는 오류"}${hint}`);
  }
  return body;
}

// MARK: 사람 확인

function confirmByHuman(title, text) {
  if (isMac) {
    // 글은 argv로 넘긴다 (AppleScript 문자열에 끼워 넣지 않는다). 기본 단추는 취소, 5분 지나면 취소.
    const script = [
      "on run argv",
      "  set r to display dialog (item 2 of argv) with title (item 1 of argv) buttons {\"취소\", \"게시\"} default button \"취소\" cancel button \"취소\" with icon caution giving up after 300",
      "  if gave up of r then return \"timeout\"",
      "  return button returned of r",
      "end run",
    ];
    const args = script.flatMap((line) => ["-e", line]);
    try {
      const answer = execFileSync("/usr/bin/osascript", [...args, title, text],
        { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
      return answer === "게시";
    } catch {
      return false; // 취소(-128) 또는 대화 상자를 띄울 수 없음
    }
  }
  // macOS가 아니면 제어 터미널에서만 묻는다 (에이전트 실행에는 TTY가 없다)
  let fd;
  try { fd = openSync("/dev/tty", "r+"); } catch { return false; }
  try {
    writeSync(fd, `\n${title}\n────────\n${text}\n────────\n게시할까요? [y/N] `);
    const buf = Buffer.alloc(16);
    const n = readSync(fd, buf, 0, 16, null);
    return /^y(es)?$/i.test(buf.toString("utf8", 0, n).trim());
  } finally { closeSync(fd); }
}

function requireTTY(command) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    throw new CliError(`\`hash-threads ${command}\`은 사람이 터미널에서 직접 실행해야 합니다.`);
  }
}

async function promptHidden(question) {
  process.stdout.write(question);
  const stdin = process.stdin;
  stdin.setRawMode(true);
  stdin.resume();
  stdin.setEncoding("utf8");
  return new Promise((resolve, reject) => {
    let value = "";
    const onData = (chunk) => {
      for (const ch of chunk) {
        if (ch === "\r" || ch === "\n") { done(); resolve(value.trim()); return; }
        if (ch === "\u0003") { done(); reject(new CliError("취소했습니다.")); return; }
        if (ch === "\u007f" || ch === "\b") value = value.slice(0, -1);
        else value += ch;
      }
    };
    const done = () => { stdin.off("data", onData); stdin.setRawMode(false); stdin.pause(); process.stdout.write("\n"); };
    stdin.on("data", onData);
  });
}

// MARK: 명령

function print(value) { process.stdout.write(JSON.stringify(value, null, 2) + "\n"); }

function validateText(text) {
  const trimmed = text?.trim();
  if (!trimmed) throw new CliError("올릴 글이 비어 있습니다.");
  const length = [...trimmed].length;
  if (length > MAX_TEXT) throw new CliError(`글이 ${length}자입니다. Threads는 ${MAX_TEXT}자까지입니다.`);
  return trimmed;
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function waitUntilReady(containerID, token) {
  // 글만 있는 게시물은 대개 바로 FINISHED. 길어도 30초까지만 기다린다.
  for (let i = 0; i < 15; i++) {
    const { status, error_message } = await call("GET", `/${containerID}`, { fields: "status,error_message" }, token);
    if (status === "FINISHED" || status === undefined) return;
    if (status === "ERROR" || status === "EXPIRED") throw new CliError(`게시물을 준비하지 못했습니다: ${error_message ?? status}`);
    await sleep(2000);
  }
  throw new CliError("게시물 준비가 30초 안에 끝나지 않았습니다. 잠시 뒤 다시 시도하세요.");
}

async function publish(text, replyTo) {
  text = validateText(text);
  if (replyTo !== undefined && !/^\d+$/.test(replyTo)) throw new CliError("--reply-to에는 게시물 숫자 id를 넣습니다.");
  const token = readToken();
  const me = await call("GET", "/me", { fields: "username" }, token);
  const title = replyTo ? `@${me.username} 계정으로 답글 달기 (대상 ${replyTo})` : `@${me.username} 계정으로 Threads에 게시`;
  if (!confirmByHuman(title, text)) {
    print({ published: false, reason: "사람이 확인하지 않았습니다 (취소·시간 초과·확인 화면 없음). 다시 시도하지 말고 사용자에게 알리세요." });
    process.exitCode = 3;
    return;
  }
  const params = { media_type: "TEXT", text };
  if (replyTo) params.reply_to_id = replyTo;
  const container = await call("POST", "/me/threads", params, token);
  await waitUntilReady(container.id, token);
  const post = await call("POST", "/me/threads_publish", { creation_id: container.id }, token);
  const detail = await call("GET", `/${post.id}`, { fields: "id,permalink,timestamp" }, token).catch(() => ({ id: post.id }));
  print({ published: true, ...detail });
}

async function main(argv) {
  const [command, ...rest] = argv;
  const flag = (name) => {
    const i = rest.indexOf(name);
    if (i === -1) return undefined;
    const value = rest[i + 1];
    if (value === undefined) throw new CliError(`${name} 뒤에 값이 필요합니다.`);
    rest.splice(i, 2);
    return value;
  };
  switch (command) {
    case "whoami": {
      print(await call("GET", "/me", { fields: "id,username,name,threads_profile_picture_url" }));
      break;
    }
    case "recent": {
      const limit = Math.min(Math.max(parseInt(flag("--limit") ?? "10", 10) || 10, 1), 50);
      const { data = [] } = await call("GET", "/me/threads", { fields: "id,text,timestamp,permalink,is_reply", limit });
      print(data);
      break;
    }
    case "post": {
      const replyTo = flag("--reply-to");
      await publish(rest.join(" "), replyTo);
      break;
    }
    case "refresh": {
      // 장기 토큰(60일)을 새로 받는다. 발급 24시간 뒤부터, 만료 전까지만 된다.
      const result = await call("GET", "/refresh_access_token", { grant_type: "th_refresh_token" });
      saveToken(result.access_token);
      print({ refreshed: true, expiresInDays: Math.round((result.expires_in ?? 0) / 86400) });
      break;
    }
    case "login": {
      requireTTY("login");
      const token = await promptHidden("Threads 장기 액세스 토큰 붙여 넣기 (화면에 보이지 않음): ");
      if (!token) throw new CliError("토큰이 비어 있습니다.");
      const me = await call("GET", "/me", { fields: "id,username" }, token);
      saveToken(token);
      console.log(`키체인에 저장했습니다: @${me.username}`);
      break;
    }
    case "logout": {
      requireTTY("logout");
      deleteToken();
      console.log("키체인에서 Threads 토큰을 지웠습니다. Meta 앱 설정에서도 권한을 취소할 수 있습니다.");
      break;
    }
    case undefined:
    case "help":
    case "--help":
    case "-h": {
      console.log(`hash-threads — Threads 공식 API CLI

  hash-threads whoami                       연결된 계정
  hash-threads recent [--limit N]           내 최근 게시물 (기본 10, 최대 50)
  hash-threads post "글"                     게시 (사람이 확인 창에서 '게시'를 눌러야 올라감)
  hash-threads post --reply-to ID "글"       답글 (threads_manage_replies 권한 필요)
  hash-threads refresh                      장기 토큰 연장 (60일)

  사람만 (터미널):
  hash-threads login                        토큰을 키체인에 저장
  hash-threads logout                       키체인에서 토큰 삭제

종료 코드: 0 성공 · 1 오류 · 2 잘못된 사용 · 3 사람이 게시를 확인하지 않음`);
      break;
    }
    default:
      process.stderr.write(`알 수 없는 명령: ${command} (hash-threads help)\n`);
      process.exitCode = 2;
  }
}

main(process.argv.slice(2)).catch((error) => {
  process.stderr.write((error instanceof CliError ? error.message : `예상하지 못한 오류: ${error.stack ?? error}`) + "\n");
  process.exitCode = 1;
});
